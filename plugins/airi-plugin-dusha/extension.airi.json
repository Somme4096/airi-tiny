{
  "manifestVersion": 2,
  "kind": "manifest.extension.airi.moeru.ai",
  "id": "airi-plugin-dusha",
  "version": "0.1.0",
  "engines": {
    "airi": "*",
    "runtimes": [
      "electron"
    ]
  },
  "entrypoints": {
    "electron": "./index.mjs"
  },
  "permissions": {
    "apis": [
      {
        "key": "kit.tool",
        "actions": [
          "invoke"
        ]
      }
    ]
  },
  "kits": {
    "uses": [
      {
        "id": "kit.tool",
        "version": "1.0.0"
      }
    ]
  }
}
